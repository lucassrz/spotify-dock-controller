<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.spotify-dock-controller"
          path="/org/gnome/shell/extensions/spotify-dock-controller/">

    <key name="placement" type="s">
      <choices>
        <choice value="panel-left"/>
        <choice value="panel-center"/>
        <choice value="panel-right"/>
        <choice value="dock-left"/>
        <choice value="dock-right"/>
      </choices>
      <default>'dock-right'</default>
      <summary>Indicator location</summary>
      <description>Top bar (left/center/right), or at the bottom, left or right of the dock.</description>
    </key>

    <key name="panel-index" type="i">
      <range min="0" max="50"/>
      <default>0</default>
      <summary>Position in the top bar area</summary>
    </key>

    <key name="dock-offset" type="i">
      <range min="-2000" max="2000"/>
      <default>8</default>
      <summary>Horizontal offset from the dock (px)</summary>
    </key>

    <key name="hide-in-overview" type="b">
      <default>false</default>
      <summary>Hide the floating widget in the Activities overview (dock mode)</summary>
    </key>

    <key name="show-text" type="b">
      <default>true</default>
      <summary>Show “Title — Artist” in the indicator</summary>
    </key>

    <key name="max-text-length" type="i">
      <range min="5" max="200"/>
      <default>40</default>
      <summary>Maximum indicator text length (characters)</summary>
    </key>

    <key name="show-mini-art" type="b">
      <default>false</default>
      <summary>Show mini album art in the indicator</summary>
    </key>

    <key name="hide-when-closed" type="b">
      <default>true</default>
      <summary>Hide the indicator when Spotify is not running (otherwise: greyed out)</summary>
    </key>

    <key name="middle-click-play-pause" type="b">
      <default>true</default>
      <summary>Middle click on the indicator = play/pause</summary>
    </key>

    <key name="debug" type="b">
      <default>false</default>
      <summary>Log placement details (journalctl)</summary>
    </key>
  </schema>
</schemalist>
